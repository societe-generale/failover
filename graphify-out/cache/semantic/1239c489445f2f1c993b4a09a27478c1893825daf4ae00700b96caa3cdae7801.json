{"nodes": [{"id": "reference_annotation_failover", "label": "@Failover Annotation", "file_type": "code", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Method-level, RUNTIME-retained, documented annotation placed on any Spring-managed bean method to declare failover behaviour."}, {"id": "reference_annotation_name", "label": "name attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required unique identifier used as FAILOVER_NAME in the store unless domain is set; must be unique across the application, and appears in logs and the startup scanner report."}, {"id": "reference_annotation_expiryduration", "label": "expiryDuration attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numeric part of the TTL (default 1), ignored when expiryDurationExpression is non-empty."}, {"id": "reference_annotation_expiryunit", "label": "expiryUnit attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ChronoUnit part of the TTL (default HOURS), ignored when expiryUnitExpression is non-empty."}, {"id": "reference_annotation_expirydurationexpression", "label": "expiryDurationExpression attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring property placeholder or SpEL evaluating to a long; externalises the TTL per environment instead of hard-coding it in the annotation, and takes precedence over expiryDuration."}, {"id": "reference_annotation_expiryunitexpression", "label": "expiryUnitExpression attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring property placeholder or SpEL evaluating to a ChronoUnit name string; overrides expiryUnit when non-empty."}, {"id": "reference_annotation_keygenerator", "label": "keyGenerator attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bean name of a custom KeyGenerator, used to override key derivation for complex or order-sensitive arguments; DefaultKeyGenerator applies when empty."}, {"id": "reference_annotation_expirypolicy", "label": "expiryPolicy attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bean name of a custom ExpiryPolicy to override TTL computation; DefaultExpiryPolicy applies when empty."}, {"id": "reference_annotation_payloadsplitter", "label": "payloadSplitter attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bean name of a PayloadSplitter; when set it enables scatter/gather mode, otherwise standard single-key behaviour applies."}, {"id": "reference_annotation_recoverall", "label": "recoverAll attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forces the scatter recover-all path even when args are non-empty, for findAll-style methods whose args are filters (status, region) not entity identities. Without it scatter would split filter args into per-slice keys that all miss, since entries were stored by entity ID. Empty args already trigger recover-all automatically. Warning: recoverAll=true with a splitter whose splitOnRecover reads args throws IndexOutOfBoundsException or produces wrong slices, so use a separate recover-all splitter bean."}, {"id": "reference_annotation_domain", "label": "domain attribute", "file_type": "concept", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional logical namespace: when set, both key hashing and FAILOVER_NAME use domain instead of name, so multiple @Failover annotations for the same business entity share store entries (a scatter store populated by findByCodes is readable by findByCode). All annotations sharing a domain should use the same TTL; mismatches are warned at startup and last writer wins."}, {"id": "reference_annotation_two_splitter_pattern", "label": "Two-splitter Pattern for recoverAll", "file_type": "rationale", "source_file": "docs/reference/annotation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a separate PayloadSplitter bean for the recover-all path whose splitOnRecover returns a single placeholder context ignoring or preserving filter args, and whose delegateR.recoverAll() fetches all slices by name."}], "edges": [{"source": "reference_annotation_failover", "target": "reference_annotation_name", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/reference/annotation.md", "source_location": null, "weight": 1.0}, {"source": "reference_annotation_failover", "target": "reference_annotation_expiryduration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/reference/annotation.md", "so