{"nodes": [{"id": "support_contributing_contributing_workflow", "label": "Contribution Workflow", "file_type": "document", "source_file": "docs/support/contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fork, branch, keep scope to one feature or fix per PR, add or update tests for every behaviour change, run mvn verify with zero Javadoc warnings, then open a PR against main. Prerequisites: JDK 21+, Maven 3.9+, Git. PRs with no activity for 30 days may be closed."}, {"id": "support_contributing_coding_conventions", "label": "Coding Conventions", "file_type": "concept", "source_file": "docs/support/contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java 21 with Spring Boot 4.x idioms; every public type and method needs Javadoc; no breaking public-API changes without a deprecation cycle and a new ADR."}, {"id": "support_contributing_adr_process", "label": "ADR Process for Architecture Decisions", "file_type": "concept", "source_file": "docs/support/contributing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New architecture decisions are appended as a new ADR; large changes should start as a discussion or ADR before any code is written."}], "edges": [{"source": "support_contributing_contributing_workflow", "target": "support_contributing_coding_conventions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/contributing.md", "source_location": null, "weight": 1.0}, {"source": "support_contributing_coding_conventions", "target": "support_contributing_adr_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/contributing.md", "source_location": null, "weight": 1.0}, {"source": "support_contributing_contributing_wor