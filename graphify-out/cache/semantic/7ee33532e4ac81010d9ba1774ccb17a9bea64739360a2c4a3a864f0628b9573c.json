{"nodes": [{"id": "how_to_exception_policy_rethrow", "label": "RETHROW exception policy", "file_type": "concept", "source_file": "docs/how-to/exception-policy.md", "source_location": "## RETHROW (Default)", "rationale": "Default because callers usually must know the upstream is unavailable and cannot gracefully handle a null response.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_to_exception_policy_never_throw", "label": "NEVER_THROW exception policy", "file_type": "rationale", "source_file": "docs/how-to/exception-policy.md", "source_location": "## NEVER_THROW", "rationale": "Suppressing the upstream exception masks outages \u2014 the caller cannot tell from the return value \u2014 so metrics (recovery.outcome not_recovered, user.impact blocked) become the monitoring signal and a startup WARN fires when it is active.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_to_exception_policy_methodexceptionpolicy", "label": "Custom MethodExceptionPolicy", "file_type": "concept", "source_file": "docs/how-to/exception-policy.md", "source_location": "## CUSTOM \u2014 Implement MethodExceptionPolicy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_to_exception_policy_error_never_recovered", "label": "Error is never recovered", "file_type": "rationale", "source_file": "docs/how-to/exception-policy.md", "source_location": "## `Error` Is Never Recovered", "rationale": "Deliberate fail-fast: java.lang.Error signals a JVM-fatal condition, not 'upstream is down', so the process should be recycled by the platform rather than limp on serving stale data \u2014 and the recovery path itself allocates, which must not run on a dying JVM.", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "how_to_exception_policy_never_throw", "target": "reference_interfaces_recoveredpayloadhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-to/exception-policy.md", "source_location": "!!! tip Combine with RecoveredPayloadHandler", "weight": 1.0}, {"source": "how_to_exception_policy_never_throw", "target": "how_to_observability_recovery_outcome_counter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-to/exception-policy.md", "source_location": "!!! warning never_throw masks outages \u2014 alert on metrics", "weight": 1.0}, {"source": "how_to_exception_policy_error_never_recovered", "target": "concepts_how_it_works_failoveraspect", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/how-to/exception-policy.md", "source_location": "## Error Is Never Recovered", "weight": 1.0}, {"source": "how_to_exception_policy_methodexceptionpolicy", "target": "concepts_how_it_works_methodexceptionhandler", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/how-to/exception-policy.md", "source_location": "## CUSTOM \u2014 Implement MethodExceptionPolicy", "weight": 1.0}, {"source": "how_to_exception_policy_rethrow", "target": "how_to_exception_policy_never_throw", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/how-to/exception-policy.md", "source_location": "## Three Strategies", "weight": 1.0}, {"source": "how_to_exception_policy_error_never_recovered", "target": "concepts_scatter_gather_partial_recovery", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/how-to/exception-policy.md", "source_location": "both argue a clean failure can be safer than degraded/partial service", "weight": 1.0}], "hyperedges": []}