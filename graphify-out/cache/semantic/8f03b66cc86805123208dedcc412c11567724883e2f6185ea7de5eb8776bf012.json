{"nodes": [{"id": "changelog_changelog_3_0_0", "label": "Changelog 3.0.0 (in development)", "file_type": "document", "source_file": "docs/changelog/changelog.md", "source_location": "[3.0.0-SNAPSHOT]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spring Boot 4.x / Java 21 with virtual threads, fixed-length MD5/UUID keys, split packages eliminated, method-aware FailoverHandler SPI, strict allowlist default flipped to true, dashboard + distributed cluster tiers, payload encryption, and the OSSRH \u2192 Central Portal publishing migration. Keep a Changelog format."}, {"id": "changelog_changelog_1_0_0", "label": "Changelog 1.0.0 (initial release)", "file_type": "document", "source_file": "docs/changelog/changelog.md", "source_location": "[1.0.0]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original surface: @Failover AOP interception, FailoverHandler store/recover/clean, InMemory/Caffeine/JDBC stores, Referential/ReferentialAware, KeyGenerator, ExpiryPolicy, PayloadEnricher, RecoveredPayloadHandler, FailoverReporter, scheduler and Resilience4j integration."}, {"id": "changelog_changelog_central_portal_migration", "label": "Maven Central publishing migration (OSSRH \u2192 Central Portal)", "file_type": "rationale", "source_file": "docs/changelog/changelog.md", "source_location": "[3.0.0-SNAPSHOT] Changed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "s01.oss.sonatype.org is decommissioned and answers HTTP 402, so the EOL nexus-staging-maven-plugin could no longer publish. central-publishing-maven-plugin (publishingServerId=central, autoPublish, waitUntil=published) owns the deploy target via extensions=true; distributionManagement and the release plugin's stagingRepository are removed. Maintainers must mint a new Central Portal user token \u2014 retired OSSRH credentials do not authenticate."}, {"id": "changelog_changelog_async_observable_publisher", "label": "Non-blocking metric publishing (AsyncObservablePublisher)", "file_type": "rationale", "source_file": "docs/changelog/changelog.md", "source_location": "[3.0.0-SNAPSHOT] Added", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps the composite publisher so every ObservablePublisher (built-in and custom) runs off the caller thread; a bounded queue with drop-on-full (counted as failover.metrics.dropped.total) guarantees metric emission never blocks a @Failover call. Set enabled=false for synchronous, deterministic tests."}, {"id": "changelog_changelog_dashboard_xss_hardening", "label": "Dashboard XSS and peer-ingest hardening", "file_type": "rationale", "source_file": "docs/changelog/changelog.md", "source_location": "[3.0.0-SNAPSHOT] Security", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-supplied strings (referential names, bean ids, exception types, peer-pushed instance ids) were interpolated raw into innerHTML; CSP blocked script execution but inline styles still allow defacement and data-id=\"${instanceId}\" was one quote from attribute breakout. Peer-ingest endpoints now validate instance ids (charset, \u2264200 chars, non-blank) and reject summary-less snapshots, and ingest fails fast when snapshot.username is set without a password \u2014 {noop} with an empty password authenticated any guessed username while startup logged ingest as secured."}, {"id": "changelog_changelog_heartbeat_inmemory_bound", "label": "HeartbeatStoreInmemory unbounded-growth fix", "file_type": "rationale", "source_file": "docs/changelog/changelog.md", "source_location": "[3.0.0-SNAPSHOT] Fixed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every distinct instance id ever POSTed stayed resident for the life of the JVM, leaving one dead entry per rolled pod forever. Now bounded by the same instance-retention window the snapshot store retires on (so nothing reachable from allInstances() is discarded) plus a 10,000-instance ceiling, and it takes a FailoverClock rather than System.currentTimeMillis() so co-located deployments age heartbeats on the same clock as expiry."}], "edges": [{"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr60_strict_allowlist", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr52_method_aware_handler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr54_collapse_store_beans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr49_scatter_collaborators", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr50_metrics_builder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr48_lifecycle_logging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelog/changelog.md", "source_location": "Changed", "weight": 1.0}, {"source": "changelog_changelog_3_0_0", "target": "adr_adr_adr55_embedded_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/changelo