{"nodes": [{"id": "quality_index_quality_and_testing", "label": "Quality & Testing Strategy", "file_type": "concept", "source_file": "docs/quality/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layered test strategy: the everyday build stays fast and hermetic, deeper heavier checks are opt-in so they never slow down day-to-day development."}, {"id": "quality_index_two_tier_default_build", "label": "Two-tier Default Build (Unit + Integration)", "file_type": "concept", "source_file": "docs/quality/index.md", "source_location": "Two-tier default build", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit tests (*Test.java, Surefire, pure Mockito/JUnit) and integration tests (*IT.java, Failsafe, @SpringBootTest on real H2). mvn clean verify runs both tiers with no Docker required, keeping the required CI gate cheap and hermetic."}, {"id": "quality_index_synchronous_store_for_determinism", "label": "failover.store.async=false in Integration Tests", "file_type": "rationale", "source_file": "docs/quality/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integration tests run with failover.store.async=false so writes are synchronous and assertions are deterministic; async writes would race the assertion."}, {"id": "quality_index_opt_in_deep_checks", "label": "Opt-in Deep Checks (Phase 3 Hardening T-1..T-4)", "file_type": "concept", "source_file": "docs/quality/index.md", "source_location": "Opt-in deep checks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added in the Phase 3 hardening pass from audit findings T-1 to T-4. Each heavy check is gated behind a Maven profile so the default build is unaffected; in CI dialect-its and mutation run as advisory non-blocking checks while the H2 build remains the required gate."}, {"id": "quality_index_concurrency_tests", "label": "Concurrency Tests (T-2)", "file_type": "concept", "source_file": "docs/quality/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contention coverage for multi-tenant store routing and the async executor path; part of the default build."}, {"id": "quality_index_architecture_tests", "label": "Architecture Tests / ArchUnit (T-3)", "file_type": "concept", "source_file": "docs/quality/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ArchUnit rules enforce the store-decorator invariants the compiler cannot express; part of the default build."}], "edges": [{"source": "quality_index_quality_and_testing", "target": "quality_index_two_tier_default_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_quality_and_testing", "target": "quality_index_opt_in_deep_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_two_tier_default_build", "target": "quality_index_synchronous_store_for_determinism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_opt_in_deep_checks", "target": "quality_integration_tests_dialect_integration_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_opt_in_deep_checks", "target": "quality_index_concurrency_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_opt_in_deep_checks", "target": "quality_index_architecture_tests", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}, {"source": "quality_index_opt_in_deep_checks", "target": "quality_mutation_testing_mutation_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "phase3_hardening_opt_in_quality_tiers", "label": "Phase 3 Hardening Quality Tiers (T-1..T-4)", "nodes": ["quality_index_opt_in_deep_checks", "quality_integration_tests_dialect_integration_tests", "quality_index_concurrency_tests", "quality_index_architecture_tests", "quality_mutation_testing_mutation_testing"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/quality/index.md"}]}