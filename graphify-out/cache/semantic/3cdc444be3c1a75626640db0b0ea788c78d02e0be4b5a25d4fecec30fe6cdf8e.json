{"nodes": [{"id": "support_about_failover_library", "label": "Failover Library", "file_type": "concept", "source_file": "docs/support/about.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open-source Spring Boot library built at Societe Generale for transparent failover of referential data; licensed Apache 2.0."}, {"id": "support_about_societe_generale", "label": "Societe Generale", "file_type": "concept", "source_file": "docs/support/about.md", "source_location": null, "source_url": "https://www.societegenerale.com", "captured_at": null, "author": null, "contributor": null}, {"id": "support_about_referential_outage_cascade", "label": "Referential Outage Cascade", "file_type": "concept", "source_file": "docs/support/about.md", "source_location": "Origins", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dozens of services depend on the same small set of slow-changing but constantly-queried referential systems (currency tables, country lists, client profiles), so one referential outage becomes a full-platform incident. Rather than solve it N times with bespoke try/catch, the team built one reusable annotation-driven solution (ADR 1)."}, {"id": "support_about_design_philosophy", "label": "Design Philosophy", "file_type": "rationale", "source_file": "docs/support/about.md", "source_location": "Design Philosophy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four principles: minimal integration (one annotation, no framework coupling); business-driven expiry (TTL is a business decision the framework enforces and teams configure); observable by default (structured logs and Micrometer metrics with no extra instrumentation); pluggable at every seam (store, key generation, expiry policy, payload enrichment, exception policy, context propagation all replaceable without modifying the framework)."}, {"id": "support_about_anand_manissery", "label": "Anand Manissery", "file_type": "concept", "source_file": "docs/support/about.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creator and lead maintainer. Other acknowledged contributors: Vincent Fuchs (contributions and review), Patrice Fricard, Igor Lovich, Abilash Titus (early contributors)."}, {"id": "support_about_apache_license_2_0", "label": "Apache License 2.0", "file_type": "concept", "source_file": "docs/support/about.md", "source_location": null, "source_url": "https://github.com/societe-generale/failover/blob/main/LICENSE", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "support_about_failover_library", "target": "support_about_societe_generale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/about.md", "source_location": null, "weight": 1.0}, {"source": "support_about_referential_outage_cascade", "target": "support_about_failover_library", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/about.md", "source_location": null, "weight": 1.0}, {"source": "support_about_failover_library", "target": "support_about_design_philosophy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/about.md", "source_location": null, "weight": 1.0}, {"source": "support_about_failover_library", "target": "support_about_apache_license_2_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/about.md", "source_location": null, "weight": 1.0}, {"source": "support_about_anand_manissery", "target": "support_about_failover_library", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/support/about.md", "source_location": null, "weight": 1.0}, {"source": "s