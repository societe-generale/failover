{"nodes": [{"id": "getting_started_migration_3_0_migration_guide", "label": "Migrating 2.x to 3.0", "file_type": "document", "source_file": "docs/getting-started/migration-3.0.md", "source_location": "# Migrating 2.x \u2192 3.0", "rationale": "3.0.0 raises platform floors to Java 21 (virtual threads for async store and scatter/gather executors) and Spring Boot 4.0.x; upgrading the platform first keeps the two migrations separate.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "getting_started_migration_3_0_package_moves", "label": "3.0 package moves (split-package elimination)", "file_type": "rationale", "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 1. Package moves (compile errors)", "rationale": "Split packages were eliminated so no two JARs share a package (JPMS-friendly, audit A-1). FailoverScanner moved out of observable because it is no longer observability-specific \u2014 it is shared by observability reporting and store deserialization safety.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "getting_started_migration_3_0_renamed_properties", "label": "3.0 renamed and removed properties", "file_type": "rationale", "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 2. Renamed properties", "rationale": "allowed-payload-classes moved under failover.store.jdbc because the allowlist only ever applied to the serializing JDBC store. dashboard shared-store jdbc.auto-ddl was removed \u2014 schema management is the consuming service's responsibility.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "getting_started_migration_3_0_scattergather_builder", "label": "ScatterGatherFailoverHandler builder migration", "file_type": "concept", "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 5. ScatterGatherFailoverHandler construction", "rationale": "Overloaded constructors were replaced by a builder (audit A-2); behaviour is unchanged and only manual construction is affected.", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "getting_started_migration_3_0_behaviour_changes", "label": "3.0 behaviour changes needing no code change", "file_type": "rationale", "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## Behaviour changes needing no code change", "rationale": "Full ReferentialPayload logging moved to DEBUG so the hot path no longer serialises a payload per call (ADR 48); fixed-length UUID keys mean old rows age out as a cold cache, not an error; recover-partial now fires only for genuine partial recovery (0 < missing < total).", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "configuration_properties_reference_strict_allowlist", "target": "getting_started_migration_3_0_renamed_properties", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 3. Deserialization now fails closed by default", "weight": 1.0}, {"source": "getting_started_migration_3_0_migration_guide", "target": "getting_started_migration_3_0_package_moves", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 1. Package moves", "weight": 1.0}, {"source": "getting_started_migration_3_0_migration_guide", "target": "getting_started_migration_3_0_scattergather_builder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 5. ScatterGatherFailoverHandler construction", "weight": 1.0}, {"source": "getting_started_migration_3_0_scattergather_builder", "target": "concepts_how_it_works_scattergatherfailoverhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 5. ScatterGatherFailoverHandler construction", "weight": 1.0}, {"source": "getting_started_migration_3_0_migration_guide", "target": "reference_interfaces_abstractfailoverhandler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 4. Custom FailoverHandler implementations", "weight": 1.0}, {"source": "getting_started_migration_3_0_migration_guide", "target": "configuration_store_types_expire_on_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "## 6. Required JDBC schema change", "weight": 1.0}, {"source": "getting_started_migration_3_0_behaviour_changes", "target": "concepts_key_generation_failoverkeygenerator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "Store keys are fixed-length", "weight": 1.0}, {"source": "getting_started_migration_3_0_behaviour_changes", "target": "how_to_observability_structured_logs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/getting-started/migration-3.0.md", "source_location": "Logging volume drops (ADR 48)", "weight": 1.0}], "hyperedges": []}